# Copy this file to .env and paste your key after the "=".
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which AI backend to use: "gemini" (default) or "ollama" (local, slow).
AI_PROVIDER=gemini

# --- Public demo limits (set DEMO_MODE=1 on any publicly reachable copy) ---
# The app has no login, so without this anyone can use your AI key without limit.
# DEMO_MODE=1
# DEMO_AI_DAILY_LIMIT=15     # AI-planned menus per day, all visitors combined
# DEMO_AI_PER_VISITOR=3      # AI-planned menus per day, per visitor
