# Copy this file to .env and paste your key after the "=".
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which AI backend to use: "gemini" (default) or "ollama" (local, slow).
AI_PROVIDER=gemini

# PIN to open the app (set your own; required, the app refuses to open without it)
APP_PIN=

# Minutes the app can sit unused before it asks for the PIN again (default 30).
SESSION_MINUTES=30

# --- Public demo deployment only (leave unset for a normal private install) ---
# DEMO_MODE=1 removes the PIN, loads invented sample households, wipes visitor
# changes every night, and caps AI use so strangers cannot run up the bill.
# Never set this on an app that holds real data.
# DEMO_MODE=1
# DEMO_AI_DAILY_LIMIT=40     # AI-planned menus per day, all visitors combined
# DEMO_AI_PER_VISITOR=3      # AI-planned menus per day, per visitor
